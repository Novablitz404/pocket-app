{
  "expo": {
    "name": "Pocket",
    "slug": "pocket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/pocket brand kit transparent/pocket_icon_lrg.png",
    "scheme": "pocket",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/pocket brand kit transparent/pocket_icon_lrg.png",
        "monochromeImage": "./assets/pocket brand kit transparent/pocket_icon_lrg.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/pocket brand kit transparent/pocket_icon_sml.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/pocket brand kit transparent/pocket_icon_lrg.png",
          "imageWidth": 220
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Pocket uses Face ID to unlock the app and confirm payments."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Pocket uses the camera to scan payment codes."
        }
      ],
      "expo-font",
      "expo-localization",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
